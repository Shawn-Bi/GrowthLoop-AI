{
  "name": "growthloop-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.mts",
    "smoke:anthropic": "vitest run --config vitest.smoke.config.mts smoke/anthropic.smoke.ts",
    "smoke:db:write": "vitest run --config vitest.smoke.config.mts smoke/postgres.smoke.ts -t \"S2 (config|write)\"",
    "smoke:db:read": "vitest run --config vitest.smoke.config.mts smoke/postgres.smoke.ts -t \"S2 (config|read)\"",
    "smoke:db:cleanup": "vitest run --config vitest.smoke.config.mts smoke/postgres.smoke.ts -t \"S2 (config|cleanup)\"",
    "smoke:deploy": "vitest run --config vitest.smoke.config.mts smoke/deployment.smoke.ts -t \"(config|S4)\"",
    "smoke:deploy:write": "vitest run --config vitest.smoke.config.mts smoke/deployment.smoke.ts -t \"(config|S2 write)\"",
    "smoke:deploy:read": "vitest run --config vitest.smoke.config.mts smoke/deployment.smoke.ts -t \"(config|S2 read)\"",
    "smoke:deploy:cleanup": "vitest run --config vitest.smoke.config.mts smoke/deployment.smoke.ts -t \"(config|S2 cleanup)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pglite-prisma-adapter": "0.7.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
