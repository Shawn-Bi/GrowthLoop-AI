# Copy to .env.local and fill in locally. Never commit real values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Neon pooled runtime connection
DATABASE_URL=
# Neon direct migration connection
DATABASE_URL_UNPOOLED=

DEMO_ACCESS_CODE=

# Optional: cycles one experiment chain may run (default 2, the PRD demo).
# The Content Agent's revision limit (3) is separate.
MAX_EXPERIMENT_CYCLES=

# Local only, for npm run smoke:deploy*; not needed on Vercel.
# Vercel → Settings → Deployment Protection → Protection Bypass for Automation
VERCEL_AUTOMATION_BYPASS_SECRET=
# Deployment to check, e.g. a preview URL (can also be set in the shell)
PREVIEW_URL=
